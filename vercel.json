{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "src/app/api/verify/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    },
    "src/app/api/verify/batch/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    },
    "src/app/api/verify/batch/[id]/stream/route.ts": {
      "memory": 2048,
      "maxDuration": 300
    },
    "src/app/api/extract/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    },
    "src/app/api/application/parse/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/warmup/route.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "src/app/api/health/route.ts": {
      "memory": 256,
      "maxDuration": 5
    },
    "src/app/api/debug/last/route.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; connect-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|webp|css|js|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
