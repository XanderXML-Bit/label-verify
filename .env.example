# ─── Vision provider keys (set at least GOOGLE_API_KEY for the primary path) ─

# Primary extractor: Gemini 3.1 Flash Lite via Google Generative AI SDK.
GOOGLE_API_KEY=

# Fallback extractor. The vertical slice runs without this; when set, verify
# and extract retry once against OpenAI only if the Gemini primary call fails.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter (https://openrouter.ai). Unlocks the full bake-off candidate
# set in `benchmarks/run.ts --bake-off` (Gemini 3.x preview, GPT-5.x,
# Claude Opus 4.7, Mistral Medium 3.5, Qwen 3.6 Flash, Llama 4 Maverick,
# Nemotron 3 Nano Omni). Not required at runtime — the primary path uses
# the direct Google SDK key above.
OPENROUTER_API_KEY=

# ─── Backup model ───────────────────────────────────────────────────────────

# Backup model — invoked only when the Gemini primary provider fails.
MODEL_FALLBACK=gpt-5.4-nano

# Application-image vision (the parser path that scans a PHOTO of an
# uploaded application form into DeclaredFields). Defaults to
# gemini-3.1-flash-lite to match the primary extractor's price tier.
# MODEL_APPLICATION_VISION=gemini-3.1-flash-lite

# ─── Verify behavior ────────────────────────────────────────────────────────

# Hard wall-clock budget is fixed in src/lib/verify.ts (60s) to avoid another
# hidden production mode. Typical Flash-Lite requests should still complete in
# a few seconds; timeout returns 504 rather than silently switching behavior.

# Per-IP rate limit on the public demo endpoint.
RATE_LIMIT_PER_MIN=60

# Batch capacity planning. We do not use Google's offline Batch API; batches run
# through one SSE worker. Default Gemini Flash-Lite Tier-1 planning is 30 RPM,
# so the safe default cap is 100 labels per interactive batch. If AI Studio shows
# a higher project RPM, set GEMINI_RPM_LIMIT and the app derives a higher cap.
GEMINI_RPM_LIMIT=30
RATE_LIMIT_BATCH_PER_MIN=3

# ─── Debug introspection ────────────────────────────────────────────────────

# Enables /api/debug/last (in-memory ring buffer of the most recent 20
# verifications). Send the value as `Authorization: Bearer <token>`. With this
# var unset the endpoint returns 404, so it is safe to leave commented out in
# production. Treat the value like a password.
# DEBUG_TOKEN=
