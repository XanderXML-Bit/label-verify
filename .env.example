# ─── Vision provider keys (set at least GOOGLE_API_KEY for the primary path) ─

# Primary extractor: Gemini 3.1 Flash Lite via Google Generative AI SDK.
GOOGLE_API_KEY=

# Fallback / escalation extractors. The vertical slice runs without these;
# they unlock C5 tiered escalation and the OOD-comparison column.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter (https://openrouter.ai). Unlocks the full bake-off candidate
# set in `benchmarks/run.ts --bake-off` (Gemini 3.x preview, GPT-5.x,
# Claude Opus 4.7, Mistral Medium 3.5, Qwen 3.6 Flash, Llama 4 Maverick,
# Nemotron 3 Nano Omni). Not required at runtime — the primary path uses
# the direct Google SDK key above.
OPENROUTER_API_KEY=

# ─── Model selection ────────────────────────────────────────────────────────

# Primary tier — fast, cheap, used by every verify call. Routine bake-off
# winner on the v2 corpus (97.6% accuracy / 2.3s P50 / $0.25 per 1k labels).
# Trace the decision in docs/MODEL-SELECTION.md §4.
MODEL_PRIMARY=gemini-3.1-flash-lite

# Stronger tier — only invoked when primary confidence is below threshold
# (C5 tiered escalation; runs OFF the critical path, so the user is not
# blocked). GPT-5.4-nano on OpenAI's direct SDK.
MODEL_FALLBACK=gpt-5.4-nano

# Application-image vision (the parser path that scans a PHOTO of an
# uploaded application form into DeclaredFields). Defaults to
# gemini-3.1-flash-lite to match the primary extractor's price tier.
# MODEL_APPLICATION_VISION=gemini-3.1-flash-lite

# ─── Verify behavior ────────────────────────────────────────────────────────

# Hard wall-clock budget for the vision call. The 5s product target is the
# end-to-end response time the brief stipulates; the vision call itself is
# given more headroom because Smart mode (Gemini Pro Preview) routinely
# takes 10-20s. The default-mode (Flash Lite) call returns in ~2-3s so the
# 5s budget is met on every typical request.
VISION_TIMEOUT_MS=60000

# Per-IP rate limit on the public demo endpoint.
RATE_LIMIT_PER_MIN=60

# Max batch size. R3 says 200–300; production deployments use 300.
# Larger batches start running into Vercel function-invocation limits
# (the streaming route is configured for maxDuration: 300, but per-item
# vision calls still need time to retry). Operators that need a higher
# cap should split the upload into multiple batches client-side.
MAX_BATCH_SIZE=1000

# ─── Debug introspection ────────────────────────────────────────────────────

# Enables /api/debug/last (in-memory ring buffer of the most recent 20
# verifications). Send the value as `Authorization: Bearer <token>`. With this
# var unset the endpoint returns 404, so it is safe to leave commented out in
# production. Treat the value like a password.
# DEBUG_TOKEN=
