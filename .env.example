# ─── Vision provider keys (set at least GOOGLE_API_KEY for the primary path) ─

# Primary extractor: Gemini 2.0 Flash via Google Generative AI SDK.
GOOGLE_API_KEY=

# Fallback / escalation extractors. The vertical slice runs without these;
# they unlock C5 tiered escalation and the OOD-comparison column.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Model selection ────────────────────────────────────────────────────────

# Primary tier — fast, cheap, used by every verify call.
MODEL_PRIMARY=gemini-2.0-flash-001

# Stronger tier — only invoked when primary confidence is below threshold
# (C5 tiered escalation; runs OFF the critical path, so the user is not
# blocked).
MODEL_FALLBACK=gpt-4o-mini

# ─── Verify behavior ────────────────────────────────────────────────────────

# Hard wall-clock budget for the vision call. Aligned with R1 (5s end-to-end);
# we leave 500ms for pre/post-processing and streaming.
VISION_TIMEOUT_MS=4500

# Per-IP rate limit on the public demo endpoint.
RATE_LIMIT_PER_MIN=60

# Max batch size (R3 says 200–300; we cap at 300).
MAX_BATCH_SIZE=300

# ─── Debug introspection ────────────────────────────────────────────────────

# Enables /api/debug/last (in-memory ring buffer of the most recent 20
# verifications). Send the value as `Authorization: Bearer <token>`. With this
# var unset the endpoint returns 404, so it is safe to leave commented out in
# production. Treat the value like a password.
# DEBUG_TOKEN=
