{
  "name": "label-verify",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered TTB label verification prototype.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx benchmarks/run.ts",
    "bench:smoke": "tsx benchmarks/run.ts --smoke",
    "bench:routine": "tsx benchmarks/run.ts --routine",
    "bench:routine:bakeoff": "tsx benchmarks/run.ts --routine --bake-off",
    "bench:bakeoff": "tsx benchmarks/run.ts --bake-off",
    "bench:bakeoff:smoke": "tsx benchmarks/run.ts --bake-off --smoke",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "gen:corpus": "tsx scripts/generate-corpus.ts",
    "validate:corpus": "tsx scripts/validate-corpus.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/generative-ai": "^0.21.0",
    "@napi-rs/canvas": "^1.0.0",
    "csv-parse": "^6.2.1",
    "fast-fuzzy": "^1.12.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.6",
    "openai": "^6.37.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
