{
  "name": "label-verify",
  "version": "0.1.0",
  "private": true,
  "description": "Independent prototype that checks beverage labels against TTB labeling rules. The public demo runs offline on three bundled samples and makes no AI model calls.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "verify:claims": "tsx bin/verify-claims.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx benchmarks/run.ts",
    "bench:smoke": "tsx benchmarks/run.ts --smoke",
    "bench:routine": "tsx benchmarks/run.ts --routine",
    "bench:routine:bakeoff": "tsx benchmarks/run.ts --routine --bake-off",
    "bench:bakeoff": "tsx benchmarks/run.ts --bake-off",
    "bench:bakeoff:smoke": "tsx benchmarks/run.ts --bake-off --smoke",
    "bench:perturb": "tsx scripts/perturb-declared.ts",
    "bench:cross-pair": "tsx bin/labelverify-bench.ts cross-pair",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "gen:corpus": "tsx scripts/generate-corpus.ts",
    "validate:corpus": "tsx scripts/validate-corpus.ts",
    "cli": "tsx bin/labelverify.ts",
    "cli:health": "tsx bin/labelverify.ts health",
    "cli:samples": "tsx bin/labelverify.ts samples",
    "cli:web": "tsx bin/labelverify-web.ts",
    "cli:web:health": "tsx bin/labelverify-web.ts health",
    "cli:web:samples": "tsx bin/labelverify-web.ts samples"
  },
  "bin": {
    "labelverify": "bin/labelverify.ts",
    "labelverify-web": "bin/labelverify-web.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.1.1",
    "@rollup/rollup-linux-x64-gnu": "^4.68.3",
    "csv-parse": "^5.5.6",
    "fast-fuzzy": "^1.12.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.28",
    "openai": "^4.68.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.6.2",
    "axe-core": "4.14.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.2.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@napi-rs/canvas": "$@napi-rs/canvas",
    "postcss": "$postcss",
    "@xmldom/xmldom": "^0.8.15",
    "form-data": "^4.0.6",
    "ws": "^8.21.0",
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2"
  }
}
